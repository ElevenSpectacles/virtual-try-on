{
  "name": "@eleven.spectacles/virtual-try-on",
  "version": "5.0.2",
  "description": "Nuxt module: virtual try-on for 3D eyewear over a live camera feed (MediaPipe + TresJS).",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "virtual-try-on",
    "try-on",
    "eyewear",
    "glasses",
    "face-tracking",
    "face-landmarker",
    "mediapipe",
    "tresjs",
    "threejs",
    "webgl",
    "webcam",
    "augmented-reality",
    "glb"
  ],
  "license": "MIT",
  "homepage": "https://elevenspectacles.com",
  "bugs": {
    "url": "https://github.com/ElevenSpectacles/virtual-try-on/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElevenSpectacles/virtual-try-on.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "prepack": "nuxt-module-build build",
    "generate-calibration": "npx tsx scripts/generate-calibration.ts",
    "compress-models": "npx tsx scripts/compress-models.ts",
    "prepare-model": "npx tsx scripts/prepare-model.ts",
    "lint-models": "npx tsx scripts/lint-models.ts",
    "fetch-footage": "node scripts/fetch-footage.mjs",
    "playground": "nuxt dev playground --port 4000",
    "typecheck": "nuxt typecheck playground",
    "verify:unit": "npx vitest run",
    "verify:playground": "node scripts/verify-playground.mjs",
    "verify": "npm run verify:unit && npm run verify:playground && npm run verify:e2e",
    "prepare": "husky",
    "verify:e2e": "playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "@nuxt/kit": "^4.6.4",
    "@tresjs/core": "^5.12.0",
    "@tresjs/nuxt": "^5.10.0",
    "three": "^0.187.0"
  },
  "peerDependencies": {
    "nuxt": "^4.5.1",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.157",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/ui": "^4.13.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vueuse/core": "^14.4.0",
    "draco3dgltf": "^1.5.9",
    "husky": "^9.1.7",
    "nuxt-skill-hub": "^0.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-doctor": "^0.1.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "@nuxt/module-builder": {
      "typescript": "$typescript"
    }
  }
}
